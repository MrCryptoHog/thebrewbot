# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Main wallet that receives all buy-ins (Solana public key)
MAIN_WALLET_ADDRESS=your_main_wallet_pubkey

# Creator wallet for profit allocation (never shown publicly)
CREATOR_WALLET_ADDRESS=your_creator_wallet_pubkey

# Hot wallet private key (base58-encoded full keypair) — KEEP SECRET
HOT_WALLET_PRIVATE_KEY=your_hot_wallet_private_key_base58

# Solana RPC URL (mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
